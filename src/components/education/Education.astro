---
import Section from "@utils/Section.astro";
import EducationItem from "@components/education/EducationItem.astro";
---
<Section id="education" title="Formation">
    <ol class="relative border-s border-slate-200">
        <EducationItem institution="Universidad Tecnológica Nacional INSPT" period="University | 2021 - June 2025">
            Studying as a <strong>Higher Technician in Applied Computer Science</strong>, I acquired skills to <strong>analyze, design, program, and maintain software</strong>, and manage <strong>IT resources</strong>. I have experience collaborating in interdisciplinary teams and developing solutions in <strong>Ecommerce, CRM, ERP</strong>, and <strong>Data Science</strong>. I also train users in the optimal use of <strong>hardware and software</strong>.
        </EducationItem>
        <EducationItem institution="Escuela Técnica Fragata Libertad" period="High School | 2014 - 2020">
            Graduated as a <strong>Computer Technician</strong>, trained to <strong>install, configure, and maintain computer systems</strong> and <strong>develop software applications</strong>. Experience in <strong>programming paradigms</strong> and teamwork with <strong>agile methodologies</strong>.
        </EducationItem>
        <EducationItem institution="Key To Language Success" period="English | 2007 - 2013">
            Complementary training in <strong>English</strong> at a specialized institution, combined with <strong>written and oral</strong> evaluations with certifications from
            <a
                    class="text-blue-400 hover:text-blue-500" target="_blank"
                    href="https://ieslvf-caba.infd.edu.ar/sitio/"
                    rel="noopener noreferrer"
                    aria-label="Official website of Lenguas Vivas (opens in a new tab)">Lenguas Vivas</a>,
            achieving an advanced level that allows me to communicate and collaborate in international teams.
        </EducationItem>
    </ol>
</Section>