---
import Section from "@utils/Section.astro";
import ProjectItem from "@components/projects/ProjectItem.astro";
import mateyTradicion from "@assets/Mate-Tradicion.avif";
import apiRestTodoList from "@assets/API-REST-Todo-List.avif";
import ejercitoMilitarWeb from "@assets/ejercito-militar-web.avif";
import bibliotecaGML from "@assets/biblioteca-GML-diagrama.avif";
import compiladorPL0 from "@assets/Compilador-PL0.avif";
---
<Section class="lg:!w-3/4" id="projects" title="Projects" class="mb-20">
    <ul class="group/list mx-auto grid grid-cols-1 sm:grid-cols-2 gap-16">
        <ProjectItem title="Mate and Tradition"
                     description="Website dedicated to exploring the culture and history of mate (the drink) through an intuitive and modern interface."
                     externalLink="https://mateytradicion.netlify.app" gitLink="https://github.com/Smilari/Mateando"
                     image={mateyTradicion}
                     technologies={[
                       {name: "Astro"},
                       {name: "Tailwind"},
                       {name: "TypeScript"},
                       {name: "React"},
                       {name: "Netlify"},
                     ]}/>
        <ProjectItem title="Todo-List REST API"
                     description="REST API to manage a list of tasks. Persistence was implemented using MongoDB, and authentication handling uses JWT."
                     externalLink="https://todografo.vercel.app" gitLink="https://github.com/Smilari/Todo-list"
                     image={apiRestTodoList}
                     technologies={[
                       {name: "Node.js"},
                       {name: "Express"},
                       {name: "MongoDB"},
                       {name: "Mongoose"},
                       {name: "JWT"},
                       {name: "JavaScript"},
                     ]}/>
        <ProjectItem title="Argentine Military Army"
                     description="ABM management web for soldiers with differentiated ranks and custom login. Spring Security was used to ensure user security by encrypting incoming passwords."
                     gitLink="https://github.com/Smilari/Ejercito-Militar-Argentino-Java"
                     image={ejercitoMilitarWeb}
                     technologies={[
                       {name: "Java"},
                       {name: "Spring"},
                       {name: "Spring Security"},
                       {name: "Thymeleaf"},
                       {name: "MySQL"},
                       {name: "Hibernate"},
                       {name: "Lombok"},
                     ]}/>
        <ProjectItem title="GML Library"
                     description="ABM project for managing members and book lending and stock. It utilizes binary files, pointers, and modular functions. Persistence was recreated using files."
                     gitLink="https://github.com/Smilari/Biblioteca-GML"
                     image={bibliotecaGML}
                     technologies={[
                       {name: "C"},
                       {name: "MySQL"},
                     ]}/>
        <ProjectItem title="PL0 Compiler"
                     description="PL/0 compiler (educational language), built in Java. This project includes lexical, syntactic, and semantic analysis functionalities, as well as code generation."
                     gitLink="https://github.com/Smilari/Compilador-PL0"
                     image={compiladorPL0}
                     technologies={[
                       {name: "Java"},
                       {name: "PL0"},
                     ]}/>
    </ul>
</Section>